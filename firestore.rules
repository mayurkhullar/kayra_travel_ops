rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Internal app access only (must be authenticated).
      allow read, write: if request.auth != null;
    }

    match /groups/{groupId} {
      // Authenticated users can read groups, and public read is allowed only
      // when traveller links are explicitly enabled on the group document.
      allow read: if request.auth != null
        || resource.data.travellerLinkEnabled == true;
      allow write: if false;
    }

    match /traveller_accounts/{accountId} {
      // Travellers can only read their own account document.
      allow read: if request.auth != null
        && accountId == request.auth.uid;

      // Travellers can only create/update their own account document, and the
      // stored authUid must match the authenticated UID.
      allow create, update: if request.auth != null
        && accountId == request.auth.uid
        && request.resource.data.authUid == request.auth.uid;

      allow delete: if false;
    }

    match /travellers/{travellerId} {
      // Travellers can only read records tied to their own account.
      allow read: if request.auth != null
        && resource.data.accountId == request.auth.uid;

      // Travellers can only create their own traveller record.
      allow create: if request.auth != null
        && request.resource.data.accountId == request.auth.uid;

      allow update, delete: if false;
    }

    match /documents/{documentId} {
      // Travellers can read only their own document records.
      allow read: if request.auth != null
        && resource.data.travellerId == request.auth.uid;

      // Travellers can create document records only for themselves.
      allow create: if request.auth != null
        && request.resource.data.travellerId == request.auth.uid;

      // Travellers can update only their own document records.
      allow update: if request.auth != null
        && resource.data.travellerId == request.auth.uid;

      // Deletes are blocked for now.
      allow delete: if false;
    }

    // Lock everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
